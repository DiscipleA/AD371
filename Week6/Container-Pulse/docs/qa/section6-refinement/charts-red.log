    .pulse-dashboard .activity-list { display: grid; align-content: start; gap: 0.8rem; max-block-size: 37rem; margin: 1rem 0 0; padding: 0.2rem; list-style: none; overflow-y: auto; scrollbar-gutter: stable; }
    .pulse-dashboard .activity-list > li { min-inline-size: 0; }
