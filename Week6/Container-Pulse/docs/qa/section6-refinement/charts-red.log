    .pulse-dashboard .stat-note { margin: 0; color: var(--pulse-accent); font-family: var(--flex-font-mono, monospace); font-size: 0.72rem; line-height: 1.55; }
    
    /* Notification cards retain visual/details/actions anatomy inside the real feed. */
    .pulse-dashboard .card-feed { display: flex; flex-direction: column; }
    .pulse-dashboard .feed-hint,
    .pulse-dashboard .observation-scope,
