# Non-secret browser-compatible credentials only. Never use a service-role/secret key.
# Hosted Edge Functions supply SUPABASE_URL and SUPABASE_ANON_KEY automatically;
# inspect the approved runtime configuration before choosing publishable fallback.
SUPABASE_URL=https://YOUR_APPROVED_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_APPROVED_PUBLIC_KEY
ALLOWED_ORIGINS=http://localhost:4173,http://127.0.0.1:4173
# No wildcard. Production example: https://showcase.example (no trailing slash).
