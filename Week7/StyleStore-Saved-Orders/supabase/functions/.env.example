# TEMPLATE ONLY. Hosted Supabase supplies SUPABASE_URL and key variables.
# Never put Mongo credentials in a VITE_* variable or browser bundle.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEYS='{"default":"sb_publishable_REPLACE_ME"}'
# Legacy projects may omit the JSON map and use SUPABASE_ANON_KEY instead.
ALLOWED_ORIGINS=http://localhost:8797,http://127.0.0.1:8797
# Add the exact deployed UI origin to ALLOWED_ORIGINS before deployment.
MONGODB_URI=mongodb+srv://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST/?retryWrites=true&w=majority
MONGODB_DB=stylestore
# Run supabase/mongo/bootstrap.mjs initializeMongo(db) as an admin first.
# Grant the runtime Mongo user readWrite only on this application database.
